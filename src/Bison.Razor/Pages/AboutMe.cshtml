@page "/about"
@model Bison.Razor.Pages.AboutMeModel
@{
    ViewData["Title"] = "About me";
    Layout = "Shared/_Layout";
}

<h1>About me</h1>
<p>This page shows all the personal data stored about you.</p>
<p>Name: @User.Identity?.Name</p>
<p>Email: @Model.Email</p>

<nav class="timeline-tabs">
   <a href="/obs/@Uri.EscapeDataString(User.Identity?.Name ?? "")?view=observations">My observations</a>
    <a href="/obs/@Uri.EscapeDataString(User.Identity?.Name ?? "")?view=comments">My comments</a>
    <a href="/obs/@Uri.EscapeDataString(User.Identity?.Name ?? "")?view=proposals">My proposals</a>
</nav>

<form method="post"
      asp-page-handler="ForgetMe"
      onsubmit="return confirm('This will delete your account. Continue?')">
    @Html.AntiForgeryToken()

    <label>
        Type FORGET to confirm:
        <input asp-for="ForgetMeConfirmation" required />
    </label>

    <button type="submit">Forget me</button>
</form>

@if (Model.ForgetMeError is not null)
{
    <p class="error">@Model.ForgetMeError</p>
}