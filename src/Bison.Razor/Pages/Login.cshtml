@page "/login"
@model Bison.Razor.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "Shared/_Layout";
}

<div class="auth-container">
    <h2>Login</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" action="/login">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

        <div class="form-group">
            <label for="Identifier">Username or Email</label>
            <input id="Identifier" name="Identifier" type="text" value="@Model.Identifier" class="form-control" autofocus autocomplete="username" maxlength="256" required />
            <span asp-validation-for="Identifier" class="error-text"></span>
        </div>

        <div class="form-group">
            <label for="Password">Password</label>
            <input id="Password" name="Password" type="password" class="form-control" autocomplete="current-password" maxlength="128" required />
            <span asp-validation-for="Password" class="error-text"></span>
        </div>

        <button type="submit" class="auth-button">Sign In</button>
    </form>
</div>
