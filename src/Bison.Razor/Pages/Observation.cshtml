@page "/ob/{id?}"
@model Bison.Razor.Pages.ObservationModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("id") ?? null;
}

<div>
    <button class="back_button" onclick="history.back()">&larr; Back</button>

    @if (Model.Observations.Count == 1)
    {
        <h2>@Model.Observations[0].Author's Observation <small>&mdash; @Model.Observations[0].Timestamp</small></h2>
        <p>@Model.Observations[0].Message</p>

        <hr />

        <h3>Comments <small>(@Model.Comments.Count)</small></h3>
        @if (Model.Comments.Any())
        {
            <ul id="commentslist" class="observations">
                @foreach (CommentViewModel comment in Model.Comments)
                {
                    <li>
                        <p>
                            <strong>
                                <a href="/obs/@comment.Author">@comment.Author</a>
                            </strong>
                            @comment.Message
                            <small>&mdash; @comment.Timestamp</small>
                        </p>
                    </li>
                }
            </ul>
        }
        <hr />

        <h3>Proposals <small>(@Model.Proposals.Count)</small></h3>
        @if (Model.Proposals.Any())
        {
            <ul id="proposalslist" class="observations">
                @foreach (ProposalViewModel proposal in Model.Proposals)
                {
                    <li>
                        <p>
                            <strong>
                                <a href="/obs/@proposal.Author">@proposal.Author</a>
                            </strong>
                            Suggested Taxon: @(!string.IsNullOrEmpty(@proposal.VernacularName) ? @proposal.VernacularName : @proposal.DwcTaxonId)
                            <small>&mdash; @proposal.Timestamp</small>
                            <br />
                            @proposal.Message
                        </p>
                    </li>
                }
            </ul>
        }
    }
    else if (Model.Observations.Any())
    {
        <h2>Public Timeline &mdash; page @Model.PageNr</h2>
        <small>Showing @Model.NrOfObservations observations</small>

        <ul id="messagelist" class="observations">
            @foreach (ObservationViewModel obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                    <hr />
                    <a href="/ob/@obs.Id">View Details</a>
                </li>
            }
        </ul>
    } 
    else
    {
        <br/>
        <em>There are no observations so far.</em>
    }
</div>
