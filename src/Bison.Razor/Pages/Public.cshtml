@page "/obs"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline &mdash; page @Model.PageNr</h2>
    <small>Showing @Model.NrOfObservations observations</small>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (ObservationViewModel obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                    <hr />
                    <a href="/ob/@obs.Id">View Details</a>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
