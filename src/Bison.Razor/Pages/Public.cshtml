@page "/obs"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline &mdash; page @Model.PageNr</h2>
    <nav class="feed-tabs">
        <a href="/obs" class="@(Model.Feed == "latest" ? "active" : "")">Latest</a>
        <a href="/obs?feed=following" class="@(Model.Feed == "following" ? "active" : "")">Following</a>
    </nav>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_ObservationForm" model="new ObservationInput()" />
    }
    <small>Showing @Model.NrOfObservations observations</small>
    
    <form method="get">
    @if (Model.Feed == "following")
    {
        <input type="hidden" name="feed" value="following" />
    }
    <input type="text" name="strTaxonId" placeholder="Filter By TaxonId" value="@Model.TaxonFilter" />
    <button type="submit">Filter</button>
    </form>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (ObservationViewModel obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @if (obs.ImageUrl != null)
                        {
                            <img class="observation-image" src="@obs.ImageUrl" alt="Observation image" />
                        }
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                    <hr />
                    <div class="observation-actions">
                        <partial name="_LikeButton" model="obs" />
                        <a href="/ob/@obs.Id">View Details</a>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        @if (Model.Feed == "following")
        {
            <em>No observations from people you follow yet. Visit a profile and press Follow to see their observations here.</em>
        }
        else
        {
            <em>There are no observations so far.</em>
        }
    }
</div>
