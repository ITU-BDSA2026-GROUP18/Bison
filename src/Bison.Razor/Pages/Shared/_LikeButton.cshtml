@model ObservationViewModel
@* Thumbs up + like count. Clicks are handled by /js/likes.js. *@
<button type="button"
        class="like-button@(Model.LikedByCurrentUser ? " liked" : "")"
        data-observation-id="@Model.Id"
        aria-pressed="@(Model.LikedByCurrentUser ? "true" : "false")"
        aria-label="Like observation"
        title="Like">
    <svg class="like-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M7 10v12" />
        <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z" />
    </svg>
    <span class="like-count">@Model.Likes</span>
</button>
