@page "/obs/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2> @routeName's Observations &mdash; page @Model.PageNr </h2>
    <small>Showing @Model.NrOfObservations observations</small>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@ob.Author">@ob.Author</a>
                        </strong>
                        @if (ob.ImageUrl != null)
                        {
                            <img class="observation-image" src="@ob.ImageUrl" alt="Observation image" />
                        }
                        @ob.Message
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
</div>
